@startuml
actor User
participant Frontend
participant "Auth API" as API
participant "User DB" as DB
participant "Token DB" as TokenDB
participant "Mail Service" as Mail

== Start Reset Request ==
User -> Frontend : Navigate to Sign In
User -> Frontend : Click "Forgot password"
Frontend -> User : Show email input form
User -> Frontend : Submit email
Frontend -> API : POST /v1/password-reset { email }

alt User exists
  API -> DB : Find user by email
  API -> TokenDB : Create PRIMARY token (TTL = 10 min, status = ACTIVE)
  API -> Mail : Send email with reset link (includes token)
  Mail -> User : Email with link /reset-password/{token}
else User does not exist
  API -> DB : Find user by email
  API --> Frontend : 200 OK
end

Frontend -> User : Show "If you're our user, we’ve sent you a reset email"

== User Clicks Email Link ==
User -> Frontend : Clicks link with token
Frontend -> API : GET /v1/password-reset/{token}
API -> TokenDB : Validate token (type: PRIMARY, status: ACTIVE, not expired)

alt Token valid
  API -> TokenDB : Mark PRIMARY token as USED and delete
  API -> TokenDB : Create SECONDARY token (TTL = 10 min)
  API --> Frontend : Return SECONDARY token + success
else Token invalid/expired
  API --> Frontend : Return error
end

== User Submits New Password ==
User -> Frontend : Enter new password
Frontend -> API : PUT /v1/password-reset { token, password }
API -> TokenDB : Validate SECONDARY token (status: ACTIVE, not expired)

alt Valid secondary token
  API -> DB : Hash password with bcrypt
  API -> DB : Update user password
  API -> TokenDB : Mark SECONDARY token as USED or delete
  API --> Frontend : Return success
else Invalid/expired token
  API --> Frontend : Return error
end
@enduml